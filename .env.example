# ------------------------------------------------------------------
# AI Weather Assistant - sample environment file
# Copy this file to ".env" and paste your own keys.
# Never commit the real .env to GitHub.
# ------------------------------------------------------------------

# Get a free key at https://openweathermap.org/api  (My API keys)
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional settings
GEMINI_MODEL=gemini-1.5-flash
UNITS=metric
